{
  "manifest_version": 3,
  "name": "DomDoc: Page Audit",
  "version": "1.3.0",
  "description": "One-click webpage audit for Performance, Accessibility, SEO, and UX. Instant scores and issue highlighting.",
  "homepage_url": "https://shubhransh-gupta.github.io/domdoc/",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DomDoc: Page Audit"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
