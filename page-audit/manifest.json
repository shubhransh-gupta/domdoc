{
  "manifest_version": 3,
  "name": "Page Audit — One-Click Lighthouse",
  "version": "1.2.0",
  "description": "Instantly audit any webpage for Performance, Accessibility, SEO, and UX issues.",
  "homepage_url": "https://shubhransh-gupta.github.io/page-audit/",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Test This Page"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
